rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function checking if request is from an authorized admin email
    function isAuthorizedAdmin() {
      return request.auth != null && 
        (request.auth.token.email.lower() == 'anirudhkaushik@galgotiasuniversity.edu.in' ||
         request.auth.token.email.lower() == 'anirudhsharma9893@gmail.com');
    }

    // Publications Collection:
    // - Public read access so anyone can view publications on any device
    // - Write/edit/delete strictly locked to authorized admins only
    match /publications/{bookId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
