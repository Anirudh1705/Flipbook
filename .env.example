# ==========================================
# 🔒 Flipbook Pro - Environment Configuration
# ==========================================

# ------------------------------------------
# Option 1: Firebase (Recommended for Secure Auth & Hacker Protection)
# ------------------------------------------
# Get these keys from https://console.firebase.google.com -> Project Settings
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ------------------------------------------
# Option 2: Supabase (Alternative Cloud SQL Backend)
# ------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
