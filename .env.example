# Supabase Configuration
# Create a free project on https://supabase.com and copy your project URL and anon public key:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Cloudflare R2 / Custom CDN base URL for your large PDFs
# Example: https://cdn.yourlibrary.com/books/
VITE_PDF_CDN_URL=https://pub-your-r2-subdomain.r2.dev/books/

# Application Settings
VITE_APP_TITLE="Digital Flipbook Library"
